# Configuration Jèko — Ahyi Rent (Copiez ce fichier en .env)
PORT=3000

# Lien de paiement officiel Jèko (Méthode 1)
JEKO_PAYMENT_LINK=https://pay.jeko.africa/pl/7932bfdd-fef8-4626-89f1-2939dff6160b

# Secret Webhook Jèko (Méthode 2 — généré par Jèko après l'enregistrement de l'URL /webhooks/jeko)
JEKO_WEBHOOK_SECRET=

# Clés API Jèko Partner (Optionnel — pour l'API directe payment_requests)
JEKO_API_KEY_ID=
JEKO_API_KEY=
JEKO_STORE_ID=
